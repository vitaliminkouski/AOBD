FROM flink:1.20.0-java11

RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-dev gcc g++ && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

RUN apt-get update && apt-get install -y --no-install-recommends openjdk-11-jdk-headless && \
    rm -rf /var/lib/apt/lists/*
RUN ln -sf /usr/lib/jvm/java-11-openjdk-$(dpkg --print-architecture) /usr/lib/jvm/java-11-openjdk
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk
RUN pip3 install --no-cache-dir apache-flink==1.20.0 kafka-python

RUN wget -q -P /opt/flink/lib/ \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.3.0-1.20/flink-sql-connector-kafka-3.3.0-1.20.jar
